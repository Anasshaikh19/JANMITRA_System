            },
            "description": "Admin and Dept Officer endpoint to register a new municipal field worker."
          }
        },
        {
          "name": "25. Update Field Worker",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designation\": \"Senior Maintenance Supervisor\",\n  \"ward\": 3,\n  \"status\": \"active\",\n  \"email\": \"santosh.updated@nmc.gov.in\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/workers/{{sample_worker_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "workers", "{{sample_worker_id}}", ""]
            },
            "description": "Updates worker profile (ward, designation, status, email). Mobile and employee_id are read-only."
          }
        }
      ]
    }
  ]
}
